{
  "buildCommand": "cd frontend-web && npm run build",
  "outputDirectory": "frontend-web/build",
  "installCommand": "cd frontend-web && npm install --ignore-scripts --legacy-peer-deps",
  "framework": "create-react-app",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"gh-pages\" ]; then exit 0; else exit 1; fi",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
