{
  "version": 2,
  "buildCommand": "cd frontend-web && CI=false npm run build",
  "outputDirectory": "frontend-web/build",
  "installCommand": "cd frontend-web && npm install --ignore-scripts --legacy-peer-deps",
  "framework": "create-react-app",
  "builds": [
    {
      "src": "frontend-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
